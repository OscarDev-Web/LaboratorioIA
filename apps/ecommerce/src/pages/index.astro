      <!-- Category Filter Tabs -->
      <div class="filter-tabs">
        <button class="filter-btn active" data-filter="all">Todas las Hamburguesas (10)</button>
        <button class="filter-btn" data-filter="parrilla">A la Parrilla</button>
        <button class="filter-btn" data-filter="clasicas">Clásicas Premium</button>
        <button class="filter-btn" data-filter="dobles">Smash & Dobles</button>
        <button class="filter-btn" data-filter="especiales">Especiales del Chef</button>
        <button class="filter-btn" data-filter="pollo-veggie">Pollo & Veggie</button>
      </div>

      <!-- Burgers Grid -->
      <div class="burgers-grid">
        {burgers.map((burger) => (
          <article class="burger-card" data-category={burger.category}>
            <div class="card-image-wrap">
              <img src={burger.image} alt={burger.name} loading="lazy" />
              <span
                class="badge-specialty"
                style={`background-color: ${burger.badgeBg}; color: ${burger.badgeColor}; border-color: ${burger.badgeBorder};`}
              >
                {burger.specialtyBadge}
              </span>
              <div class="rating-badge">
                <span>⭐</span> {burger.rating}
              </div>
            </div>

            <div class="card-body">
              <div class="card-meta">
                <span>{burger.categoryName}</span>
                <span>⏱️ {burger.cookTime} &bull; 🔥 {burger.calories}</span>
              </div>

              <h4 class="card-title">{burger.name}</h4>
              <p class="card-desc">{burger.description}</p>

              <div class="card-footer">
                <div class="card-price">
                  <span class="card-price-label">Precio</span>
                  <span class="card-price-value">${burger.price.toFixed(2)}</span>
                </div>

                <div class="card-actions">
                  <button
                    class="btn-detail open-modal-btn"
                    data-burger={JSON.stringify(burger)}
                  >
                    Ver Detalles
                  </button>
                  <a href="/app" class="btn-order-quick">
                    Pedir <span>👉</span>
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- App Promo Banner -->
  <div class="container">
    <div class="app-promo-banner">
      <div class="promo-content">
        <div class="pill-badge" style="background:#FFFFFF; border-color:#FDE68A;">
          <span>📲 Experiencia Móvil Progresiva (PWA)</span>
        </div>
        <h3>Simula y Ordena tus Hamburguesas en Nuestra App</h3>
        <p>
          Instala o navega nuestra PWA móvil con navegación por pestañas inferiores (Menú, Ofertas, Órdenes en tiempo real y Perfil VIP con RapidPoints).
        </p>
        <div class="promo-perks">
          <div class="perk-item">✔ 20% OFF en primera orden (CUPÓN: RAPID20)</div>
          <div class="perk-item">✔ Rastreador de parrilla en vivo</div>
          <div class="perk-item">✔ Funciona offline</div>
        </div>
        <div style="display: flex; gap: 14px; flex-wrap: wrap;">
          <a href="/app" class="btn btn-primary" style="padding: 12px 24px;">
            📱 Abrir PWA Mobile Ahora
          </a>
          <a href="/admin" class="btn btn-outline" style="padding: 12px 20px;">
            ⚙️ Ver Dashboard Admin
          </a>
        </div>
      </div>
      <div style="text-align: center;">
        <div style="display: inline-block; background: #FFFFFF; padding: 24px; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border: 1px solid #FDE68A;">
          <div style="font-size: 3.5rem; margin-bottom: 8px;">🍔⚡</div>
          <div style="font-weight: 800; color: #78350F; font-size: 1.1rem;">Hamburger Rapid PWA</div>
          <div style="font-size: 0.85rem; color: #92400E; margin-top: 4px;">Lista para simular pedidos</div>
          <div style="margin-top: 14px; font-size: 0.75rem; background: #FEF3C7; color: #B45309; padding: 6px 12px; border-radius: var(--radius-full); font-weight: 700;">
            Tab Navigation &bull; Checkout Simulado
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Detail Modal -->
  <div class="modal-backdrop" id="burgerModal" role="dialog" aria-modal="true" aria-hidden="true">
    <div class="modal-content">
      <button class="modal-close-btn" id="modalCloseBtn" aria-label="Cerrar modal">&times;</button>
      
      <div class="modal-image-wrap">
        <img id="modalImg" src="" alt="" />
      </div>

      <div class="modal-body">
        <div class="modal-badges">
          <span id="modalSpecialtyBadge" class="badge-specialty" style="position: static; box-shadow: none;"></span>
          <span id="modalRating" style="font-size: 0.85rem; font-weight: 700; color: #0F172A; display: flex; align-items: center; gap: 4px;"></span>
        </div>

        <h3 id="modalTitle" class="modal-title"></h3>
        <p id="modalDesc" class="modal-desc"></p>

        <div class="modal-specs">
          <div class="spec-item">
            <small>Tiempo Cocción</small>
            <span id="modalCookTime"></span>
          </div>
          <div class="spec-item">
            <small>Calorías</small>
            <span id="modalCalories"></span>
          </div>
          <div class="spec-item">
            <small>Proteínas</small>
            <span id="modalProtein"></span>
          </div>
        </div>

        <h4 class="modal-section-title">🥩 Ingredientes y Preparación Artesanal:</h4>
