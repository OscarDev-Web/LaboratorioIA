          <div>
            <div class="boxed-flyer-tag">DE POLLO</div>
            <div class="boxed-flyer-sub">Pollo crispy (Pollo crocante, cheddar y ensalada)</div>
          </div>
          <div class="boxed-flyer-price">S/18.00</div>
        </div>
      </div>
    </div>
  </section>

  <!-- CATALOG SECTION -->
  <section class="container" id="catalogo">
    <div class="filter-wrapper">
      <div class="filter-header-text">Selecciona tu categoría favorita</div>
      <div class="filter-pills">
        <button class="filter-btn active" data-filter="all">Todas (12)</button>
        <button class="filter-btn" data-filter="clasicas">Clásicas a la Brasa</button>
        <button class="filter-btn" data-filter="especiales">Especiales de la Casa</button>
        <button class="filter-btn" data-filter="pollo-veggie">Pollo & Veggie</button>
        <button class="filter-btn" data-filter="gourmet">Nivel Supremo</button>
      </div>
    </div>

    <!-- Burger Cards Grid -->
    <div class="menu-grid">
      {burgers.map((burger) => (
        <article class="burger-card" data-category={burger.category}>
          <div class="card-img-wrap">
            <img src={burger.image} alt={burger.name} class="card-img" loading="lazy" />
            
            <div class="card-badges">
              <span class={`category-script-badge ${burger.categoryStyle}`}>
                {burger.categoryName}
              </span>
            </div>

            <!-- Price Badge on top-right -->
            {burger.badgeType === 'stamp-yellow' ? (
              <div class="stamp-badge-yellow">{burger.priceFormatted}</div>
            ) : burger.badgeType === 'stamp-red' ? (
              <div class="stamp-badge-red">{burger.priceFormatted}</div>
            ) : (
              <div style="position: absolute; top: 14px; right: 14px; z-index: 5;">
                <span class="white-price-pill">{burger.priceFormatted}</span>
              </div>
            )}
          </div>

          <div class="card-body">
            <div class="card-title-row">
              <h3 class="card-title">
                <span class="arrow">▶</span> {burger.menuLabel}
              </h3>
            </div>

            <div class="card-subtitle">"{burger.subtitle}"</div>

            <p class="card-desc">{burger.description}</p>

            <div class="card-specs">
              <div class="spec-item">⏱️ {burger.cookTime}</div>
              <div class="spec-item">🔥 {burger.calories}</div>
              <div class="spec-item">💪 {burger.protein}</div>
              <div class="spec-item" style="margin-left: auto; color: #facc15; font-weight: 700;">
                ⭐ {burger.rating}
              </div>
            </div>

            <div class="card-footer">
              <button 
                class="btn btn-dark open-modal-btn" 
                data-burger={JSON.stringify(burger)}
                style="width: 100%;"
              >
                🔍 Ver Receta
              </button>
              <a href="/app" class="btn btn-fire" title="Pedir esta hamburguesa en la PWA">
                PEDIR 🛵
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- MODAL: Burger Recipe Details -->
  <div class="modal-backdrop" id="burgerModal" aria-hidden="true">
    <div class="modal-card">
      <button class="modal-close-btn" id="modalCloseBtn" aria-label="Cerrar ventana">&times;</button>
      
      <div class="modal-img-wrap">
        <img id="modalImg" src="" alt="Hamburguesa Detalle" class="modal-img" />
      </div>

      <div class="modal-content">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <h2 class="modal-title" id="modalTitle"></h2>
          <span class="white-price-pill" id="modalPrice" style="font-size: 1.3rem;"></span>
        </div>

        <div class="modal-subtitle" id="modalSubtitle"></div>
        <p class="modal-desc" id="modalDesc"></p>

        <div class="modal-ingredients-title">🥩 INGREDIENTES Y PREPARACIÓN:</div>
        <ul class="modal-ingredients-list" id="modalIngredients"></ul>

        <div style="background: #111; padding: 12px 16px; border-radius: 12px; border: 1px solid #27272a; margin-bottom: 22px; font-size: 0.88rem;">
          <span style="color: #facc15; font-weight: 700;">Maridaje sugerido:</span> <span id="modalPairing"></span>
        </div>

        <div class="modal-actions">
          <a href="/app" class="btn btn-fire" style="flex: 1;">
            PEDIR ESTA BURGER EN PWA 📱
          </a>
          <button class="btn btn-dark" id="modalDismissBtn">
            Volver a la Carta
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: Reference Flyer Preview -->
  <div class="modal-backdrop" id="flyerModal" aria-hidden="true">
    <div class="modal-card flyer-preview-modal">
      <button class="modal-close-btn" id="flyerCloseBtn" aria-label="Cerrar afiche">&times;</button>
      <div style="padding: 24px;">
        <h3 style="font-family: var(--font-title); font-size: 2.2rem; color: #fff;">
          📜 CARTA IMPRESA ORIGINAL
        </h3>
        <p style="font-size: 0.88rem; color: #a1a1aa; margin-top: 4px;">
          Afiche gastronómico oficial ubicado en <code>assets-references/images/9754b9aa579fb8fcbee7519febf32758.jpg</code>
        </p>

        <img 
          src="/images/menu-referencia.jpg" 
          alt="Afiche oficial de Hamburguesas" 
          class="flyer-preview-img"
        />

        <p style="font-size: 0.85rem; color: #fde047; margin-top: 8px;">
          Esta Landing Page adopta íntegramente la paleta negra pizarra, títulos grunge, banderas rojas y sellos de precios de esta carta física.
        </p>

        <button class="btn btn-fire" id="flyerDismissBtn" style="margin-top: 14px; width: 100%;">
          ENTENDIDO, VOLVER AL SITIO
        </button>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="brand" style="margin-bottom: 14px;">
            <div class="brand-flame" style="width: 42px; height: 42px; font-size: 1.6rem;">🍔</div>
            <div>
              <div class="brand-title" style="font-size: 1.6rem;">HAMBURGER <span>RAPID</span></div>
              <span class="brand-tag">Sabor a la Brasa</span>
            </div>
          </div>
          <p style="font-size: 0.88rem; color: var(--text-muted); line-height: 1.6; max-width: 320px;">
            Hamburguesas a la brasa elaboradas con recetas tradicionales y gourmet. Inspirado en nuestra carta física con tecnología Full-Stack de alto desempeño.
          </p>
        </div>

        <div class="footer-col">
          <h5>Ecosistema</h5>
          <ul>
            <li><a href="#catalogo">Catálogo de 12 Variedades</a></li>
            <li><a href="/app">PWA Móvil (/app)</a></li>
            <li><a href="/admin">Panel de Administración (/admin)</a></li>
            <li><a href="/api/health">Estado de la API (/api/health)</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h5>Favoritas del Menú</h5>
          <ul>
            <li><a href="#catalogo">Mary's Burger (S/15.00)</a></li>
            <li><a href="#catalogo">Hamburguesa Clásica (S/10.00)</a></li>
            <li><a href="#catalogo">A lo Pobre (S/17.00)</a></li>
            <li><a href="#catalogo">Vegetariana de Lentejas (S/15.00)</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h5>Atención & Delivery</h5>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px;">
            Lunes a Domingo: 11:30 AM - 01:00 AM
          </p>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 12px;">
            Pedidos inmediatos vía PWA Mobile
          </p>
          <button class="btn btn-fire" style="font-size: 1rem; padding: 8px 18px;" onclick="window.location.href='/app'">
            ABRIR PWA MÓVIL 📱
          </button>
        </div>
      </div>

      <div class="footer-bottom">
        <div>&copy; 2026 Hamburger Rapid Inc. Diseño adaptado según el afiche oficial de referencia.</div>
        <div style="display: flex; gap: 16px;">
          <a href="/" style="color: #a1a1aa; text-decoration: none;">E-commerce</a>
          <a href="/app" style="color: #a1a1aa; text-decoration: none;">PWA App</a>
          <a href="/admin" style="color: #a1a1aa; text-decoration: none;">Panel Admin</a>
        </div>
      </div>
    </div>
  </footer>

  <!-- Client-side JavaScript -->
  <script is:inline>
    // Category Filtering
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        burgerCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Recipe Modal
    const modal = document.getElementById('burgerModal');
    const closeBtn = document.getElementById('modalCloseBtn');
    const dismissBtn = document.getElementById('modalDismissBtn');

    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalPrice = document.getElementById('modalPrice');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalPairing = document.getElementById('modalPairing');

    function openModal(data) {
      modalImg.src = data.image;
      modalImg.alt = data.name;
      modalTitle.textContent = data.name;
      modalSubtitle.textContent = `"${data.subtitle}"`;
      modalDesc.textContent = data.description;
      modalPrice.textContent = data.priceFormatted;
      modalPairing.textContent = data.pairing;

      modalIngredients.innerHTML = '';
      if (data.ingredients && Array.isArray(data.ingredients)) {
        data.ingredients.forEach(item => {
          const li = document.createElement('li');
          li.textContent = item;
          modalIngredients.appendChild(li);
        });
      }

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.open-modal-btn').forEach(button => {
      button.addEventListener('click', () => {
        const burgerData = JSON.parse(button.getAttribute('data-burger'));
        openModal(burgerData);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    dismissBtn.addEventListener('click', closeModal);

    // Flyer Preview Modal
    const flyerModal = document.getElementById('flyerModal');
    const openFlyerBtn = document.getElementById('openFlyerBtn');
    const flyerCloseBtn = document.getElementById('flyerCloseBtn');
    const flyerDismissBtn = document.getElementById('flyerDismissBtn');

    function openFlyer() {
      flyerModal.classList.add('active');
      flyerModal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeFlyer() {
      flyerModal.classList.remove('active');
      flyerModal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    if (openFlyerBtn) openFlyerBtn.addEventListener('click', openFlyer);
    if (flyerCloseBtn) flyerCloseBtn.addEventListener('click', closeFlyer);
    if (flyerDismissBtn) flyerDismissBtn.addEventListener('click', closeFlyer);

    // Click outside and escape key handling
    window.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
      if (e.target === flyerModal) closeFlyer();
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        if (modal.classList.contains('active')) closeModal();
        if (flyerModal.classList.contains('active')) closeFlyer();
      }
    });
  </script>
</body>
</html>
