        <div class="pairing-box">
          <span style="font-size: 1.2rem;">💡</span>
          <div>
            <strong>Sugerencia del Chef:</strong>
            <p id="modalPairing" style="margin-top: 2px;"></p>
          </div>
        </div>

        <div class="modal-footer">
          <div>
            <div style="font-size: 0.75rem; color: #64748B; font-weight: 600; text-transform: uppercase;">Precio Final</div>
            <div id="modalPrice" style="font-size: 1.7rem; font-weight: 800; color: #0F172A;"></div>
          </div>
          <div style="display: flex; gap: 10px;">
            <button class="btn btn-outline" id="modalDismissBtn" style="padding: 10px 18px;">Cerrar</button>
            <a href="/app" class="btn btn-primary" style="padding: 10px 22px;">
              📲 Pedir en PWA Móvil
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col">
          <div class="brand" style="margin-bottom: 14px;">
            <div class="brand-icon" style="width: 40px; height: 40px; font-size: 1.5rem;">🍔</div>
            <div class="brand-text">
              <h2 style="font-size: 1.2rem; font-weight: 800;">Hamburger Rapid</h2>
              <span>Comercial Fast Food</span>
            </div>
