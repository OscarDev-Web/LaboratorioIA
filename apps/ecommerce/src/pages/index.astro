  <!-- Client JavaScript for Filters and Modal -->
  <script is:inline>
    // Category Filter Logic
    const filterButtons = document.querySelectorAll('.filter-btn');
    const burgerCards = document.querySelectorAll('.burger-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        burgerCards.forEach(card => {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal Logic
    const modal = document.getElementById('burgerModal');
    const closeBtn = document.getElementById('modalCloseBtn');
    const dismissBtn = document.getElementById('modalDismissBtn');

    const modalImg = document.getElementById('modalImg');
    const modalTitle = document.getElementById('modalTitle');
    const modalDesc = document.getElementById('modalDesc');
    const modalPrice = document.getElementById('modalPrice');
    const modalSpecialtyBadge = document.getElementById('modalSpecialtyBadge');
    const modalRating = document.getElementById('modalRating');
    const modalCookTime = document.getElementById('modalCookTime');
    const modalCalories = document.getElementById('modalCalories');
    const modalProtein = document.getElementById('modalProtein');
    const modalIngredients = document.getElementById('modalIngredients');
    const modalPairing = document.getElementById('modalPairing');

    function openModal(data) {
      modalImg.src = data.image;
      modalImg.alt = data.name;
      modalTitle.textContent = data.name;
      modalDesc.textContent = data.description;
      modalPrice.textContent = `$${data.price.toFixed(2)}`;
      
      modalSpecialtyBadge.textContent = data.specialtyBadge;
      modalSpecialtyBadge.style.backgroundColor = data.badgeBg;
      modalSpecialtyBadge.style.color = data.badgeColor;
      modalSpecialtyBadge.style.borderColor = data.badgeBorder;

      modalRating.innerHTML = `⭐ ${data.rating} / 5.0`;
      modalCookTime.textContent = data.cookTime;
      modalCalories.textContent = data.calories;
      modalProtein.textContent = data.protein || '45g';
      modalPairing.textContent = data.pairing;

      // Populate ingredients
      modalIngredients.innerHTML = '';
      if (data.ingredients && Array.isArray(data.ingredients)) {
        data.ingredients.forEach(item => {
          const li = document.createElement('li');
          li.textContent = item;
          modalIngredients.appendChild(li);
        });
      }

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.open-modal-btn').forEach(button => {
      button.addEventListener('click', () => {
        const burgerData = JSON.parse(button.getAttribute('data-burger'));
        openModal(burgerData);
      });
    });

    closeBtn.addEventListener('click', closeModal);
    dismissBtn.addEventListener('click', closeModal);

    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  </script>
</body>
