        <li><a href="/app" style="color: var(--primary);">PWA Móvil</a></li>
      </ul>

      <div class="nav-actions">
        <a href="/admin" class="btn btn-admin">⚙️ Panel Admin</a>
        <a href="/app" class="btn btn-primary">📱 Pedir en la App</a>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="pill-badge">
          <span>✨ 100% Carne Angus Certificada &bull; Entrega en &lt; 20 min</span>
        </div>
        <h2 class="hero-title">
          El Sabor de la <span class="highlight">Hamburguesa Real</span> a la Velocidad de tu Hambre
        </h2>
        <p class="hero-subtitle">
          Elaboradas a la parrilla de carbón vivo con pan brioche artesanal recién horneado y salsas de autor.
          Descubre nuestras 10 variantes exclusivas creadas para verdaderos amantes del sabor gourmet.
        </p>

        <div class="hero-cta">
          <a href="#catalogo" class="btn btn-primary" style="padding: 14px 28px; font-size: 1rem;">
            🍔 Explorar Menú Completo
          </a>
          <a href="/app" class="btn btn-outline" style="padding: 14px 24px; font-size: 1rem;">
            📲 Ordenar en PWA Móvil
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <h3>4.98 ⭐</h3>
            <p>Más de 14,000 reseñas</p>
          </div>
          <div class="stat-item">
            <h3>18 min ⚡</h3>
            <p>Tiempo promedio de entrega</p>
          </div>
          <div class="stat-item">
            <h3>100% 🥩</h3>
            <p>Carne fresca sin congelar</p>
          </div>
        </div>
      </div>

      <div class="hero-image-wrapper">
        <div class="hero-image-card">
          <img
            src="https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=900&auto=format&fit=crop&q=80"
            alt="Rey de las Burgers - Hamburger Rapid"
          />
        </div>
        <div class="floating-card">
          <div class="floating-card-icon">👑</div>
          <div>
            <div style="font-size: 0.8rem; font-weight: 700; color: #B45309; text-transform: uppercase;">Hamburguesa Destacada</div>
            <div style="font-size: 1.05rem; font-weight: 800; color: #0F172A;">Rey de las Burgers</div>
            <div style="font-size: 0.85rem; color: #64748B;">Triple Angus &bull; $14.99</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Strip -->
  <section class="benefits-strip" id="experiencia">
    <div class="container benefits-grid">
      <div class="benefit-box">
        <div class="benefit-icon">🔥</div>
        <div class="benefit-text">
          <h4>Parrilla de Roble</h4>
          <p>Sabor ahumado único a fuego vivo</p>
        </div>
      </div>
      <div class="benefit-box">
        <div class="benefit-icon">🍞</div>
        <div class="benefit-text">
          <h4>Brioche Horneado</h4>
          <p>Masa madre suave y tostada</p>
        </div>
      </div>
      <div class="benefit-box">
        <div class="benefit-icon">🛵</div>
        <div class="benefit-text">
          <h4>Empaque Térmico</h4>
          <p>Crujiente y caliente hasta tu mesa</p>
        </div>
      </div>
      <div class="benefit-box">
        <div class="benefit-icon">💎</div>
        <div class="benefit-text">
          <h4>RapidPoints VIP</h4>
          <p>Acumula puntos con tu PWA</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Catalog Section (10 Featured Variants) -->
  <section class="catalog-section" id="catalogo">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Colección Exclusiva 2026</span>
        <h3 class="section-title">Catálogo de 10 Variantes Destacadas</h3>
        <p class="section-desc">
          Desde clásicas perfeccionadas hasta creaciones de alta cocina. Cada hamburguesa es forjada con pasión y los ingredientes más selectos del mercado.
        </p>
