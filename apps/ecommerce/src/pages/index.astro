<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content="Hamburguesas artesanales a la brasa al estilo tradicional y gourmet. Consulta nuestra carta completa, pide online por PWA y disfruta del mejor sabor parrillero." />

  <!-- Google Fonts: Bebas Neue (Grunge Title), Caveat (Script headers), Plus Jakarta Sans (Clean UI) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Caveat:wght@700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&family=Yellowtail&display=swap" rel="stylesheet">

  <style>
    :root {
      /* Palette inspired by authentic restaurant flyer */
      --bg-chalk: #0c0c0e;
      --bg-chalk-subtle: #141418;
      --bg-card: #18181c;
      --bg-card-hover: #222228;
      --border-chalk: #2e2e36;
      --border-highlight: #dc2626;

      --flyer-red: #dc2626;
      --flyer-red-dark: #991b1b;
      --flyer-red-glow: rgba(220, 38, 38, 0.45);

      --flyer-yellow: #facc15;
      --flyer-yellow-gold: #eab308;
      --flyer-yellow-glow: rgba(250, 204, 21, 0.4);

      --text-main: #f4f4f5;
      --text-muted: #a1a1aa;
      --text-yellow: #fde047;

      --font-title: 'Bebas Neue', Impact, sans-serif;
      --font-script: 'Caveat', 'Yellowtail', cursive;
      --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-chalk);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.5;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 20%, rgba(220, 38, 38, 0.12) 0%, transparent 35%),
        radial-gradient(circle at 85% 60%, rgba(234, 179, 8, 0.09) 0%, transparent 40%),
        radial-gradient(circle at 50% 90%, rgba(220, 38, 38, 0.15) 0%, transparent 50%),
        repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.01) 0, rgba(255, 255, 255, 0.01) 1px, transparent 0, transparent 40px);
    }

    /* Container */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
    }

    /* HEADER */
    header {
      background: rgba(12, 12, 14, 0.94);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border-bottom: 2px solid #27272a;
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.6);
    }

    .nav-wrapper {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 80px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .brand-flame {
      font-size: 2.2rem;
      background: linear-gradient(135deg, #ef4444, #b91c1c);
      width: 52px;
      height: 52px;
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 18px var(--flyer-red-glow);
      border: 2px solid #f87171;
      animation: flamePulse 2.5s infinite alternate ease-in-out;
    }

    @keyframes flamePulse {
      0% { box-shadow: 0 0 12px rgba(220, 38, 38, 0.4); transform: scale(1); }
      100% { box-shadow: 0 0 24px rgba(239, 68, 68, 0.7); transform: scale(1.04); }
    }

    .brand-title {
      font-family: var(--font-title);
      font-size: 2rem;
      letter-spacing: 0.05em;
      color: #ffffff;
      line-height: 1;
      text-shadow: 2px 2px 0px #000;
    }

    .brand-title span {
      color: var(--flyer-yellow);
    }

    .brand-tag {
      font-family: var(--font-script);
      font-size: 1.15rem;
      color: #f87171;
      letter-spacing: 0.02em;
      display: block;
      margin-top: -3px;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 22px;
      border-radius: 9999px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.25s ease;
      font-size: 0.95rem;
      border: none;
    }

    .btn-fire {
      background: linear-gradient(135deg, #ef4444, #dc2626 50%, #991b1b 100%);
      color: #ffffff;
      font-family: var(--font-title);
      font-size: 1.25rem;
      letter-spacing: 0.06em;
      box-shadow: 0 4px 18px var(--flyer-red-glow);
      border: 1px solid #f87171;
    }

    .btn-fire:hover {
      background: linear-gradient(135deg, #dc2626, #b91c1c);
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(239, 68, 68, 0.65);
      color: #ffffff;
    }

    .btn-yellow {
      background: linear-gradient(135deg, #fde047, #eab308);
      color: #0f0f11;
      font-family: var(--font-title);
      font-size: 1.25rem;
      letter-spacing: 0.05em;
      box-shadow: 0 4px 15px var(--flyer-yellow-glow);
      border: 1px solid #fef08a;
    }

    .btn-yellow:hover {
      background: linear-gradient(135deg, #eab308, #ca8a04);
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(234, 179, 8, 0.55);
    }

    .btn-dark {
      background: #18181c;
      color: #ffffff;
      border: 1px solid #3f3f46;
      font-size: 0.88rem;
    }

    .btn-dark:hover {
      border-color: var(--flyer-yellow);
      color: var(--flyer-yellow);
      background: #27272a;
    }

    /* HERO SECTION */
    .hero {
      padding: 60px 0 40px;
      position: relative;
      overflow: hidden;
    }

    /* Floating Decor (Flyer Accents) */
    .floating-accent {
      position: absolute;
      pointer-events: none;
      z-index: 1;
      filter: drop-shadow(0 8px 16px rgba(0,0,0,0.7));
      user-select: none;
    }

    .floating-tomato {
      top: 15px;
      left: 3%;
      width: 78px;
      animation: floatSlow 6s ease-in-out infinite alternate;
    }

    .floating-basil {
      top: 190px;
      left: 1%;
      width: 50px;
      animation: floatRotate 7s ease-in-out infinite alternate;
    }

    .floating-onion {
      top: 240px;
      right: 48%;
      width: 60px;
      animation: floatSlow 5s ease-in-out infinite alternate 1s;
    }

    .floating-fries {
      top: 210px;
      right: 2%;
      width: 80px;
      animation: floatRotate 8s ease-in-out infinite alternate;
    }

    @keyframes floatSlow {
      0% { transform: translateY(0px) rotate(0deg); }
      100% { transform: translateY(-16px) rotate(6deg); }
    }

    @keyframes floatRotate {
      0% { transform: translateY(0px) rotate(-10deg); }
      100% { transform: translateY(-12px) rotate(15deg); }
    }

    /* Giant Title styled after Flyer */
    .hero-title-box {
      text-align: center;
      margin-bottom: 30px;
